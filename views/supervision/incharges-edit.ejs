<%- include('../partials/header', { title: 'Edit In-charge Login', activePage: 'supervision' }) %>
<div class="page-header"><div><h1>✏️ Edit In-charge Login</h1><div class="breadcrumb"><a href="/supervision/incharges" style="color:rgba(255,255,255,0.8)">In-charges</a> → Edit</div></div></div>

<form method="POST" action="/supervision/incharges/<%= inc.id %>/edit">
<div class="form-card">
  <div class="form-card-header">🔑 Login Details</div>
  <div class="form-card-body">
    <div class="form-grid">
      <div class="form-group"><label>Name <span class="required">*</span></label><input type="text" name="name" class="form-control" value="<%= inc.name %>" required></div>
      <div class="form-group"><label>Wing</label><input type="text" class="form-control" value="<%= inc.wing && WINGS[inc.wing] ? WINGS[inc.wing].label : 'Unassigned' %>" disabled><small>Change the wing from the In-charges list.</small></div>
      <div class="form-group"><label>Email <span class="required">*</span></label><input type="email" name="email" class="form-control" value="<%= inc.email %>" required></div>
      <div class="form-group"><label>New Password</label><input type="password" name="password" class="form-control" minlength="6" autocomplete="new-password" placeholder="Leave blank to keep the current password"></div>
    </div>
  </div>
</div>
<div class="form-card"><div class="form-actions"><button type="submit" class="btn btn-purple">💾 Save Changes</button><a href="/supervision/incharges" class="btn btn-outline-purple">Cancel</a></div></div>
</form>
<%- include('../partials/footer') %>
