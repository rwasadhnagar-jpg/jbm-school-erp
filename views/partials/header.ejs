<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — JBM ERP</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="manifest" href="/manifest.json">
  <script src="/js/push.js" defer></script>
</head>
<body>

<nav class="navbar">
  <button id="sidebarToggle" class="hamburger-btn" type="button" aria-label="Menu">☰</button>
  <div class="navbar-brand">
    <img src="/img/logo.png" alt="JBM Logo" style="height:38px;width:38px;object-fit:contain;border-radius:50%;background:#fff;padding:2px;" onerror="this.style.display='none'">
    <span>JBM Public School</span>
    <span class="school-badge">ERP</span>
  </div>
  <div class="navbar-right">
    <button id="enable-push-btn" type="button" style="background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.3);color:#fff;border-radius:6px;padding:4px 10px;font-size:12px;cursor:pointer">🔔 Enable Notifications</button>
    <span class="user-info">👤 <span><%= user.name %></span> (<%= user.role %>)</span>
    <span style="color:rgba(255,255,255,0.4)">|</span>
    <span class="navbar-ay" style="color:#fff;font-size:12px;opacity:0.8;">AY: <%= academicYear %></span>
    <a href="/logout">Logout</a>
  </div>
</nav>

<% const role = user.role; %>
<% const showSupervisionForRaters = true; /* UAT: Performance now pulls its auto-fill from Weekly Attendance + Class Observations, so Academic Supervision must stay visible to incharges/principal for a real test */ %>

<div id="sidebarBackdrop" class="sidebar-backdrop"></div>
<aside class="sidebar" id="sidebar">
  <div class="sidebar-section">
    <a href="/dashboard" class="sidebar-item <%= activePage === 'dashboard' ? 'active' : '' %>">
      <span class="icon">📊</span><span class="label">Dashboard</span>
    </a>
  </div>

  <% if (role === 'incharge' && user.wings && user.wings.length > 1) { %>
  <% const WING_LABELS = { pre_primary:'Pre-Primary Wing', primary:'Primary Wing', middle_secondary:'Middle & Secondary Wing', sr_secondary:'Sr. Secondary Wing' }; %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">Currently managing</div>
    <form method="GET" action="/supervision" style="padding:0 12px">
      <select class="form-control form-control-sm" onchange="location.href='/supervision?wing='+this.value" style="width:100%">
        <% user.wings.forEach(function(w) { %>
        <option value="<%= w %>" <%= user.wing === w ? 'selected' : '' %>><%= WING_LABELS[w] || w %></option>
        <% }) %>
      </select>
    </form>
  </div>
  <% } %>

  <% if (role === 'admin') { %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">Academic</div>
    <a href="/weekly" class="sidebar-item <%= activePage === 'weekly' ? 'active' : '' %>">
      <span class="icon">🗓️</span><span class="label">This Week</span>
    </a>
    <a href="/timetablemanagement" class="sidebar-item <%= activePage === 'timetable' ? 'active' : '' %>">
      <span class="icon">📅</span><span class="label">Timetable</span>
    </a>
  </div>
  <% } %>

  <% if (role === 'teacher') { %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">My Class</div>
    <a href="/weekly" class="sidebar-item <%= activePage === 'weekly' ? 'active' : '' %>">
      <span class="icon">🗓️</span><span class="label">This Week</span>
    </a>
    <a href="/attday" class="sidebar-item <%= activePage === 'attendance' ? 'active' : '' %>">
      <span class="icon">✅</span><span class="label">Attendance</span>
    </a>
    <a href="/remarks" class="sidebar-item <%= activePage === 'remarks' ? 'active' : '' %>">
      <span class="icon">📝</span><span class="label">Progress / Remarks</span>
    </a>
    <a href="/performance/my-report-card" class="sidebar-item <%= activePage === 'performance' ? 'active' : '' %>">
      <span class="icon">📈</span><span class="label">My Report Card</span>
    </a>
  </div>
  <% } %>

  <% if (['principal','vice_principal','incharge'].includes(role)) { %>
  <% if (showSupervisionForRaters) { %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">Academic Supervision</div>
    <a href="/supervision" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">🗓️</span><span class="label">This Week</span>
    </a>
    <a href="/supervision/rotation" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">🎲</span><span class="label">Weekly Rotation</span>
    </a>
    <a href="/supervision/observations" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">🔍</span><span class="label">Class Observations</span>
    </a>
    <% if (role === 'incharge') { %>
    <a href="/supervision/attendance" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">📅</span><span class="label">Staff Attendance</span>
    </a>
    <% } %>
    <% if (role === 'principal') { %>
    <a href="/supervision/cross-wing" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">🔀</span><span class="label">Cross-Wing Teachers</span>
    </a>
    <a href="/supervision/class-teachers" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">🏫</span><span class="label">Class-Teacher Assignment</span>
    </a>
    <% } %>
  </div>
  <% } %>

  <% } %>

  <% if (['principal','incharge'].includes(role)) { %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">Teacher Assessment</div>
    <a href="/performance/monthly/entry" class="sidebar-item <%= activePage === 'performance' ? 'active' : '' %>">
      <span class="icon">📝</span><span class="label">Score Entry</span>
    </a>
    <% if (role === 'principal') { %>
    <a href="/performance/memos" class="sidebar-item <%= activePage === 'performance' ? 'active' : '' %>">
      <span class="icon">⚠️</span><span class="label">Memos</span>
    </a>
    <% } %>
  </div>
  <% } %>

  <% if (role === 'admin') { %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">Administration</div>
    <a href="/studentadministration" class="sidebar-item <%= activePage === 'students' ? 'active' : '' %>">
      <span class="icon">👨‍🎓</span><span class="label">Students</span>
    </a>
    <a href="/teachers" class="sidebar-item <%= activePage === 'staff' ? 'active' : '' %>">
      <span class="icon">👩‍🏫</span><span class="label">Staff</span>
    </a>
    <a href="/attday" class="sidebar-item <%= activePage === 'attendance' ? 'active' : '' %>">
      <span class="icon">✅</span><span class="label">Attendance</span>
    </a>
    <a href="/remarks" class="sidebar-item <%= activePage === 'remarks' ? 'active' : '' %>">
      <span class="icon">📝</span><span class="label">Progress / Remarks</span>
    </a>
    <a href="/lms" class="sidebar-item <%= activePage === 'library' ? 'active' : '' %>">
      <span class="icon">📚</span><span class="label">Library</span>
    </a>
    <a href="/transport" class="sidebar-item <%= activePage === 'transport' ? 'active' : '' %>">
      <span class="icon">🚌</span><span class="label">Transport</span>
    </a>
    <a href="/hostel" class="sidebar-item <%= activePage === 'hostel' ? 'active' : '' %>">
      <span class="icon">🏠</span><span class="label">Hostel</span>
    </a>
  </div>
  <% } %>

  <% if (role === 'admin') { %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">Teacher Assessment</div>
    <a href="/performance/pulse" class="sidebar-item <%= activePage === 'performance' ? 'active' : '' %>">
      <span class="icon">📊</span><span class="label">Teacher Pulse</span>
    </a>
    <a href="/performance/annual" class="sidebar-item <%= activePage === 'performance' ? 'active' : '' %>">
      <span class="icon">📈</span><span class="label">Annual Summary</span>
    </a>
    <a href="/performance/monthly" class="sidebar-item <%= activePage === 'performance' ? 'active' : '' %>">
      <span class="icon">🗒️</span><span class="label">Monthly History</span>
    </a>
    <a href="/performance/memos" class="sidebar-item <%= activePage === 'performance' ? 'active' : '' %>">
      <span class="icon">⚠️</span><span class="label">Memos</span>
    </a>
    <a href="/performance/roster" class="sidebar-item <%= activePage === 'performance' ? 'active' : '' %>">
      <span class="icon">📋</span><span class="label">Assessment Roster</span>
    </a>
    <a href="/performance/raters" class="sidebar-item <%= activePage === 'performance' ? 'active' : '' %>">
      <span class="icon">🔑</span><span class="label">Rater Logins</span>
    </a>
    <a href="/performance/settings" class="sidebar-item <%= activePage === 'performance' ? 'active' : '' %>">
      <span class="icon">⚖️</span><span class="label">Weights & Settings</span>
    </a>
  </div>
  <% } %>

  <% if (role === 'admin') { %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">Academic Supervision</div>
    <a href="/supervision" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">🗓️</span><span class="label">Weekly Overview</span>
    </a>
    <a href="/supervision/rotation" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">🎲</span><span class="label">Weekly Rotation</span>
    </a>
    <a href="/supervision/attendance" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">📅</span><span class="label">Staff Attendance</span>
    </a>
    <a href="/supervision/observations" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">🔍</span><span class="label">Class Observations</span>
    </a>
    <a href="/supervision/meeting" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">🗒️</span><span class="label">Weekly Meeting Minutes</span>
    </a>
    <a href="/supervision/teacher-overview" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">📊</span><span class="label">Teacher Overview</span>
    </a>
    <a href="/supervision/incharges" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">🔑</span><span class="label">Manage In-charges</span>
    </a>
    <a href="/supervision/cross-wing" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">🔀</span><span class="label">Cross-Wing Teachers</span>
    </a>
    <a href="/supervision/class-teachers" class="sidebar-item <%= activePage === 'supervision' ? 'active' : '' %>">
      <span class="icon">🏫</span><span class="label">Class-Teacher Assignment</span>
    </a>
  </div>
  <% } %>

  <% if (role === 'librarian') { %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">Administration</div>
    <a href="/lms" class="sidebar-item <%= activePage === 'library' ? 'active' : '' %>">
      <span class="icon">📚</span><span class="label">Library</span>
    </a>
  </div>
  <% } %>

  <% if (role === 'transport') { %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">Administration</div>
    <a href="/transport" class="sidebar-item <%= activePage === 'transport' ? 'active' : '' %>">
      <span class="icon">🚌</span><span class="label">Transport</span>
    </a>
  </div>
  <% } %>

  <% if (role === 'admin') { %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">Certificates</div>
    <a href="/certificates" class="sidebar-item <%= activePage === 'certificates' ? 'active' : '' %>">
      <span class="icon">📜</span><span class="label">TC & Certificates</span>
    </a>
  </div>
  <% } %>

  <% if (role === 'admin') { %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">Communication</div>
    <a href="/sms" class="sidebar-item <%= activePage === 'sms' ? 'active' : '' %>">
      <span class="icon">📱</span><span class="label">SMS & WhatsApp</span>
    </a>
    <a href="/notices" class="sidebar-item <%= activePage === 'notices' ? 'active' : '' %>">
      <span class="icon">📢</span><span class="label">Notices</span>
    </a>
  </div>
  <% } %>

  <% if (['admin','accountant'].includes(role)) { %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">Financial</div>
    <% if (role === 'admin') { %>
    <a href="/registration" class="sidebar-item <%= activePage === 'admission' ? 'active' : '' %>">
      <span class="icon">📋</span><span class="label">Admissions</span>
    </a>
    <% } %>
    <a href="/feemanagement" class="sidebar-item <%= activePage === 'fees' ? 'active' : '' %>">
      <span class="icon">💰</span><span class="label">Fee Management</span>
    </a>
    <a href="/sal" class="sidebar-item <%= activePage === 'salary' ? 'active' : '' %>">
      <span class="icon">💵</span><span class="label">Salary</span>
    </a>
  </div>
  <% } %>

  <% if (role === 'admin') { %>
  <div class="sidebar-section">
    <div class="sidebar-section-title">Setup</div>
    <a href="/configuration" class="sidebar-item <%= activePage === 'config' ? 'active' : '' %>">
      <span class="icon">⚙️</span><span class="label">Configuration</span>
    </a>
    <a href="/configuration/backup" class="sidebar-item <%= activePage === 'backup' ? 'active' : '' %>">
      <span class="icon">🗄️</span><span class="label">DB Backup</span>
    </a>
    <a href="/configuration/import" class="sidebar-item <%= activePage === 'import' ? 'active' : '' %>">
      <span class="icon">📥</span><span class="label">Import Data</span>
    </a>
  </div>
  <% } %>

</aside>

<main class="main-content">
  <% if (success && success.length) { %>
    <div class="alert alert-success">✅ <%= success[0] %></div>
  <% } %>
  <% if (error && error.length) { %>
    <div class="alert alert-error">⚠️ <%= error[0] %></div>
  <% } %>
