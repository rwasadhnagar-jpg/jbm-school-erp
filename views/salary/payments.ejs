<%- include('../partials/header', { title: 'Salary Payment History', activePage: 'salary' }) %>

<div class="page-header">
  <div>
    <h1>💳 Salary Payment History</h1>
    <div class="breadcrumb">Salary Management &bull; All Payments</div>
  </div>
  <a href="/sal" class="btn btn-purple">← Back to PBR</a>
</div>

<% if (!months.length) { %>
<div class="card" style="text-align:center;padding:60px;color:#999;">
  <div style="font-size:48px;">📭</div>
  <p style="margin-top:16px;font-size:16px;">No salary payments recorded yet.</p>
  <p>Generate a PBR and click <strong>Mark as Paid</strong> to record payments.</p>
  <a href="/sal" class="btn btn-purple" style="margin-top:12px;">Go to Pay Bill Register</a>
</div>
<% } else { %>
<div class="card">
  <div class="card-body" style="padding:0;">
    <table style="width:100%;border-collapse:collapse;font-size:13px;">
      <thead>
        <tr style="background:#4A0E8F;color:#fff;">
          <th style="padding:10px 14px;text-align:left;">Month & Year</th>
          <th style="padding:10px 14px;text-align:center;">Staff Paid</th>
          <th style="padding:10px 14px;text-align:right;">Total Net Pay</th>
          <th style="padding:10px 14px;text-align:center;">Payment Mode</th>
          <th style="padding:10px 14px;text-align:center;">Payment Date</th>
          <th style="padding:10px 14px;text-align:center;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% const mNames = ['','January','February','March','April','May','June','July','August','September','October','November','December']; %>
        <% months.forEach((m, i) => { %>
        <tr style="background:<%= i%2===0?'#fff':'#faf5ff' %>;border-bottom:1px solid #f0f0f0;">
          <td style="padding:10px 14px;font-weight:600;color:#4A0E8F;">
            <%= mNames[m.month_no] %> <%= m.year_no %>
          </td>
          <td style="padding:10px 14px;text-align:center;">
            <span style="background:#e9d5ff;color:#7e22ce;border-radius:12px;padding:2px 10px;font-weight:600;">
              <%= m.staff_count %> staff
            </span>
          </td>
          <td style="padding:10px 14px;text-align:right;font-weight:700;color:#16a34a;">
            ₹<%= Number(m.total_net).toLocaleString('en-IN') %>
          </td>
          <td style="padding:10px 14px;text-align:center;">
            <span style="background:#dbeafe;color:#1e40af;border-radius:4px;padding:2px 8px;font-size:12px;">
              <%= m.payment_mode %>
            </span>
          </td>
          <td style="padding:10px 14px;text-align:center;color:#555;">
            <% if (m.pay_date) { %>
              <%= new Date(m.pay_date).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) %>
            <% } else { %>—<% } %>
          </td>
          <td style="padding:10px 14px;text-align:center;">
            <a href="/sal/payments/<%= m.year_no %>/<%= m.month_no %>" class="btn btn-outline btn-sm">View Details</a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<%- include('../partials/footer') %>
