<%- include('../partials/header', { title: 'Monthly Review Entry', activePage: 'performance' }) %>
<div class="page-header"><div><h1>📝 Monthly Review Entry</h1><div class="breadcrumb">Teacher Assessment → Monthly Review</div></div></div>

<% if (justSaved) { %>
<div class="dashboard-widget" style="margin-bottom:12px;border-left:4px solid #28a745">
  <div class="widget-body">✅ Saved — on to the next teacher.</div>
</div>
<% } %>

<div class="toolbar" style="flex-wrap:wrap;align-items:center">
  <span style="font-size:13px;color:#555">Teacher <strong><%= position %></strong> of <strong><%= totalCount %></strong></span>
  <% if (prevStaff) { %><a href="/performance/monthly/entry/<%= prevStaff.id %>?month=<%= month %>" class="btn btn-outline-purple btn-sm">← <%= prevStaff.first_name %></a><% } %>
  <% if (nextStaff) { %><a href="/performance/monthly/entry/<%= nextStaff.id %>?month=<%= month %>" class="btn btn-outline-purple btn-sm"><%= nextStaff.first_name %> →</a><% } %>
  <a href="/performance/monthly/entry?month=<%= month %>" class="btn btn-outline-purple btn-sm">📋 Full Roster</a>
</div>

<% if (!isIncharge && (existing.entered_by || existing.submitted_at)) { %>
<div class="dashboard-widget" style="margin-bottom:12px;font-size:12px;color:#555">Entered by this teacher's wing Incharge — you're reviewing/editing it.</div>
<% } %>

<form method="POST" action="/performance/monthly/entry/<%= staff.id %>">
  <input type="hidden" name="month" value="<%= month %>">

  <div class="form-card">
    <div class="form-card-header">👩‍🏫 <%= staff.first_name %> <%= staff.last_name || '' %> <span style="font-weight:400;opacity:0.85">— <%= new Date(month).toLocaleDateString('en-IN', { month: 'long', year: 'numeric' }) %></span></div>
    <div class="form-card-body">
      <div class="widget-body" style="padding:0 0 10px;font-size:12px;color:#555">
        🔒 Attendance, late arrivals and discipline (and the four ratings below) come from the
        <a href="/supervision/attendance">Saturday Staff Attendance entry</a> — change them there, not here.
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label>Attendance % 🔒</label>
          <input type="text" class="form-control" readonly style="background:#f3f0f8"
            value="<%= attendanceAuto && attendanceAuto.attendancePct != null ? attendanceAuto.attendancePct : (existing.attendance_pct != null ? existing.attendance_pct : '—') %>">
          <% if (attendanceAuto) { %>
          <div style="font-size:10px;color:#777">from <%= attendanceAuto.weeksLogged %> Saturday entr<%= attendanceAuto.weeksLogged === 1 ? 'y' : 'ies' %> — <%= attendanceAuto.totalWorking %> working days, <%= attendanceAuto.totalLeaves %> leave<%= attendanceAuto.totalLeaves === 1 ? '' : 's' %></div>
          <% } else { %><div style="font-size:10px;color:#999">no Saturday entries logged this month yet</div><% } %>
          <% if (attendanceAuto && attendanceAuto.totalClubbed > 0) { %>
          <div style="font-size:11px;color:#a15c00;background:#fff3cd;border-radius:4px;padding:2px 6px;margin-top:4px;display:inline-block">⚠️ <%= attendanceAuto.totalClubbed %> leave<%= attendanceAuto.totalClubbed === 1 ? '' : 's' %> clubbed with a holiday this month</div>
          <% } %>
        </div>
        <div class="form-group">
          <label>Late Arrivals 🔒</label>
          <input type="text" class="form-control" readonly style="background:#f3f0f8" value="<%= countsAuto.late %>">
          <div style="font-size:10px;color:#777"><%= countsAuto.weeklyLate %> from Saturday entries<%= countsAuto.memoLate ? ' + ' + countsAuto.memoLate + ' punctuality memo' + (countsAuto.memoLate === 1 ? '' : 's') : '' %></div>
        </div>
        <div class="form-group"><label>Parent Complaints</label><input type="number" step="1" min="0" class="form-control" name="parent_complaints" value="<%= existing.parent_complaints != null ? existing.parent_complaints : 0 %>"></div>
        <div class="form-group">
          <label>Discipline Issues 🔒</label>
          <input type="text" class="form-control" readonly style="background:#f3f0f8" value="<%= countsAuto.discipline %>">
          <div style="font-size:10px;color:#777"><%= countsAuto.weeklyDiscipline %> from Saturday entries<%= countsAuto.memoDiscipline ? ' + ' + countsAuto.memoDiscipline + ' discipline memo' + (countsAuto.memoDiscipline === 1 ? '' : 's') : '' %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="form-card" style="margin-top:16px">
    <div class="form-card-header">🎯 Teaching &amp; Outcomes (0-10)</div>
    <% if (obsAuto) { %>
    <div class="widget-body" style="padding:10px 16px 0;font-size:12px;color:#777">4 of these pre-filled from <%= obsAuto.observationCount %> class observation<%= obsAuto.observationCount === 1 ? '' : 's' %> you logged for this teacher this month — adjust any that don't look right.</div>
    <% } %>
    <div class="form-card-body">
      <div class="form-grid">
        <div class="form-group">
          <label>Syllabus Pace</label>
          <input type="number" step="0.1" min="0" max="10" class="form-control" name="syllabus_pace"
            value="<%= existing.syllabus_pace != null ? existing.syllabus_pace : (obsAuto && obsAuto.syllabus_pace != null ? obsAuto.syllabus_pace : '') %>">
          <% if (existing.syllabus_pace == null && obsAuto && obsAuto.syllabus_pace != null) { %><div style="font-size:10px;color:#777">(auto from observations)</div><% } %>
        </div>
        <div class="form-group">
          <label>Classroom Management</label>
          <input type="number" step="0.1" min="0" max="10" class="form-control" name="classroom_mgmt"
            value="<%= existing.classroom_mgmt != null ? existing.classroom_mgmt : (obsAuto && obsAuto.classroom_mgmt != null ? obsAuto.classroom_mgmt : '') %>">
          <% if (existing.classroom_mgmt == null && obsAuto && obsAuto.classroom_mgmt != null) { %><div style="font-size:10px;color:#777">(auto from observations)</div><% } %>
        </div>
        <div class="form-group">
          <label>Homework Correction</label>
          <input type="number" step="0.1" min="0" max="10" class="form-control" name="homework_correction"
            value="<%= existing.homework_correction != null ? existing.homework_correction : (obsAuto && obsAuto.homework_correction != null ? obsAuto.homework_correction : '') %>">
          <% if (existing.homework_correction == null && obsAuto && obsAuto.homework_correction != null) { %><div style="font-size:10px;color:#777">(auto from observations)</div><% } %>
        </div>
        <div class="form-group">
          <label>Student Outcomes</label>
          <input type="number" step="0.1" min="0" max="10" class="form-control" name="student_outcomes_override"
            value="<%= existing.student_outcomes_override != null ? existing.student_outcomes_override : (outcomesAuto != null ? outcomesAuto : '') %>">
          <% if (existing.student_outcomes_override == null && outcomesAuto != null) { %><div style="font-size:10px;color:#777">(auto from exam data)</div><% } %>
          <% if (existing.student_outcomes_override == null && outcomesAuto == null) { %><div style="font-size:10px;color:#999">no exam data yet</div><% } %>
        </div>
        <div class="form-group">
          <label>Overall Holistic</label>
          <input type="number" step="0.1" min="0" max="10" class="form-control" name="overall_holistic"
            value="<%= existing.overall_holistic != null ? existing.overall_holistic : (obsAuto && obsAuto.overall_holistic != null ? obsAuto.overall_holistic : '') %>">
          <% if (existing.overall_holistic == null && obsAuto && obsAuto.overall_holistic != null) { %><div style="font-size:10px;color:#777">(auto from observations)</div><% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="form-card" style="margin-top:16px">
    <div class="form-card-header">📋 Saturday Checklist (0-10) 🔒</div>
    <% if (weeklyAuto) { %>
    <div class="widget-body" style="padding:10px 16px 0;font-size:12px;color:#777">Average of this month's Saturday ratings (1-5 shown here ×2 as 0-10). Read-only — edit them on the <a href="/supervision/attendance">Saturday sheet</a>.</div>
    <% } else { %>
    <div class="widget-body" style="padding:10px 16px 0;font-size:12px;color:#999">No Saturday ratings logged yet this month<%= existing.punctuality_rating != null || existing.dress_code_rating != null || existing.overall_conduct_rating != null || existing.lesson_prep_rating != null ? ' — showing the previously saved values' : '' %>.</div>
    <% } %>
    <div class="form-card-body">
      <div class="form-grid">
        <% [['punctuality_rating', 'Punctuality'], ['dress_code_rating', 'Dress Code Compliance'], ['overall_conduct_rating', 'Overall Conduct'], ['lesson_prep_rating', 'Lesson Preparation']].forEach(function (f) {
             const shown = weeklyAuto && weeklyAuto[f[0]] != null ? weeklyAuto[f[0]] : (existing[f[0]] != null ? existing[f[0]] : '—'); %>
        <div class="form-group">
          <label><%= f[1] %></label>
          <input type="text" class="form-control" readonly style="background:#f3f0f8" value="<%= shown %>">
        </div>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="form-card" style="margin-top:16px">
    <div class="form-card-header">🤝 Other Ratings (0-10)</div>
    <div class="form-card-body">
      <div class="form-grid">
        <div class="form-group"><label>Parent Communication</label><input type="number" step="0.1" min="0" max="10" class="form-control" name="parent_comm" value="<%= existing.parent_comm != null ? existing.parent_comm : '' %>"></div>
        <div class="form-group"><label>Admin Compliance</label><input type="number" step="0.1" min="0" max="10" class="form-control" name="admin_compliance" value="<%= existing.admin_compliance != null ? existing.admin_compliance : '' %>"></div>
        <div class="form-group"><label>Co-curricular</label><input type="number" step="0.1" min="0" max="10" class="form-control" name="cocurricular" value="<%= existing.cocurricular != null ? existing.cocurricular : '' %>"></div>
        <div class="form-group"><label>Professional Development</label><input type="number" step="0.1" min="0" max="10" class="form-control" name="professional_dev" value="<%= existing.professional_dev != null ? existing.professional_dev : '' %>"></div>
        <div class="form-group"><label>Behaviour / Teamwork</label><input type="number" step="0.1" min="0" max="10" class="form-control" name="behaviour_teamwork" value="<%= existing.behaviour_teamwork != null ? existing.behaviour_teamwork : '' %>"></div>
      </div>
    </div>
  </div>

  <div class="form-card" style="margin-top:16px">
    <div class="form-card-header">💬 Notes</div>
    <div class="form-card-body">
      <textarea class="form-control" name="notes" rows="2"><%= existing.notes || '' %></textarea>
    </div>
  </div>

  <div class="form-card"><div class="form-actions">
    <button type="submit" class="btn btn-purple">💾 Save &amp; Next Teacher</button>
    <a href="/performance/monthly/entry?month=<%= month %>" class="btn btn-outline-purple">Full Roster</a>
  </div></div>
</form>
<%- include('../partials/footer') %>
