<%- include('../partials/header', { title: 'Monthly Review Entry', activePage: 'performance' }) %>
<div class="page-header"><div><h1>📝 Monthly Review Entry</h1><div class="breadcrumb">Teacher Assessment → Monthly Review</div></div></div>

<div class="dashboard-widget" style="margin-bottom:16px">
  <div class="widget-body">
    <% if (isIncharge) { %>
    Scoring as Incharge, for your own wing's teachers. "Student Outcomes" pre-fills from real exam data, and several fields pre-fill from your own Academic Monitoring class observations of that teacher this month, where logged.
    <% } else { %>
    Reviewing/editing as <%= isChairman ? 'Admin' : 'Principal' %> — you can open and correct any teacher's entry, entered by their wing Incharge.
    <% } %>
  </div>
</div>

<% if (allDone) { %>
<div class="dashboard-widget" style="margin-bottom:16px;border-left:4px solid #28a745">
  <div class="widget-body">✅ Every teacher has been scored for this month. You can still revisit anyone below to adjust.</div>
</div>
<% } %>

<div class="toolbar" style="flex-wrap:wrap">
  <form method="GET" action="/performance/monthly/entry" class="search-bar" style="flex-wrap:wrap">
    <select name="month" class="form-control form-control-sm" onchange="this.form.submit()" style="width:180px">
      <% months.forEach(function(m) { %>
      <option value="<%= m %>" <%= m===month?'selected':'' %>><%= new Date(m).toLocaleDateString('en-IN',{month:'long',year:'numeric'}) %></option>
      <% }) %>
    </select>
    <% if (canPickWing) { %>
    <select name="wing" class="form-control form-control-sm" onchange="this.form.submit()" style="width:220px">
      <option value="">All wings</option>
      <% Object.keys(WINGS).forEach(function(w) { %>
      <option value="<%= w %>" <%= pickedWing===w?'selected':'' %>><%= WINGS[w].label %></option>
      <% }) %>
    </select>
    <% } %>
  </form>
</div>

<div class="cards-grid">
  <div class="stat-card">
    <div class="stat-icon bg-purple">📊</div>
    <div><div class="stat-value"><%= doneCount %> / <%= totalCount %></div><div class="stat-label">Teachers Scored This Month</div></div>
  </div>
</div>

<% const wingParam = pickedWing ? '&wing=' + encodeURIComponent(pickedWing) : ''; %>
<div class="toolbar">
  <% if (firstUnscoredId) { %>
  <a href="/performance/monthly/entry/<%= firstUnscoredId %>?month=<%= month %><%= wingParam %>" class="btn btn-purple">▶️ Continue Scoring</a>
  <% } else { %>
  <a href="/performance/monthly/entry/<%= staffList[0] ? staffList[0].id : '' %>?month=<%= month %><%= wingParam %>" class="btn btn-outline-purple">Review / Adjust Scores</a>
  <% } %>
  <label style="display:inline-flex;align-items:center;gap:6px;font-size:12px;color:#555;margin-left:10px">
    <input type="checkbox" id="hideScored"> Show only not-yet-scored
  </label>
</div>

<div class="table-container">
  <div class="table-header"><h3>Roster (<%= totalCount %> teaching staff)</h3></div>
  <table>
    <thead><tr><th>Name</th><th style="width:120px">Status</th><th style="width:100px"></th></tr></thead>
    <tbody id="rosterBody">
      <% staffList.forEach(function(s) { %>
      <tr data-scored="<%= s.scored ? '1' : '0' %>">
        <td><%= s.first_name %> <%= s.last_name %></td>
        <td><span class="badge <%= s.scored ? 'badge-green' : 'badge-red' %>"><%= s.scored ? 'Scored' : 'Not yet' %></span></td>
        <td><a href="/performance/monthly/entry/<%= s.id %>?month=<%= month %><%= wingParam %>" class="btn btn-outline-purple btn-sm">Score →</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<script>
  document.getElementById('hideScored').addEventListener('change', function (e) {
    document.querySelectorAll('#rosterBody tr').forEach(function (tr) {
      tr.hidden = e.target.checked && tr.getAttribute('data-scored') === '1';
    });
  });
</script>

<%- include('../partials/footer') %>
