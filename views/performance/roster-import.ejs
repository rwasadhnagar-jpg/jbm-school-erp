<%- include('../partials/header', { title: 'Import Staff Roster', activePage: 'performance' }) %>
<div class="page-header"><div><h1>📥 Import Staff Roster</h1><div class="breadcrumb"><a href="/performance/roster" style="color:rgba(255,255,255,0.8)">Roster</a> → Import</div></div></div>

<div class="dashboard-widget" style="margin-bottom:16px">
  <div class="widget-body">
    Upload the "Staff Roster" sheet from <code>JBM_Monthly_Teacher_Assessment_System.xlsx</code>. Reads <strong>Employee Name</strong>, <strong>Staff Type</strong>, <strong>Date of Joining</strong>, <strong>Date of Leaving</strong>, and <strong>Years of Service</strong> columns. Matches existing staff by name, so it's safe to re-run if the spreadsheet is corrected later.
  </div>
</div>

<div class="table-container">
  <div class="table-header"><h3>Upload File</h3></div>
  <form method="POST" action="/performance/roster/import" enctype="multipart/form-data" style="padding:20px">
    <div class="form-group">
      <label>Excel File (.xlsx)</label>
      <input type="file" name="file" accept=".xlsx,.xls" required class="form-control">
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-purple">📤 Upload &amp; Import</button>
      <a href="/performance/roster" class="btn btn-outline-purple">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
