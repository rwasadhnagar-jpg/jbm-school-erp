<%- include('../partials/header', { title: 'Principal / Vice Principal Logins', activePage: 'performance' }) %>
<div class="page-header"><div><h1>🔑 Principal / Vice Principal Logins</h1><div class="breadcrumb">Teacher Assessment → Logins</div></div></div>

<div class="dashboard-widget" style="margin-bottom:16px">
  <div class="widget-body">
    Each wing's Incharge enters the monthly review for their own teachers (create/manage those under <a href="/supervision/incharges">Academic Supervision → Manage In-charges</a>, where a wing is always set). Principal can review and correct any teacher's entry, and issues memos. Vice Principal has no role in Teacher Performance.
  </div>
</div>

<div class="toolbar">
  <a href="/performance/raters/add" class="btn btn-purple">+ Add Login</a>
</div>

<div class="table-container">
  <div class="table-header"><h3>Logins (<%= raters.length %>)</h3></div>
  <table>
    <thead><tr><th>#</th><th>Name</th><th>Email</th><th>Role</th><th>Status</th></tr></thead>
    <tbody>
      <% if (raters.length) { raters.forEach((r,i) => { %>
      <tr>
        <td><%= i+1 %></td>
        <td><strong><%= r.name %></strong></td>
        <td><%= r.email %></td>
        <td><span class="badge badge-blue"><%= r.role === 'vice_principal' ? 'Vice Principal' : (r.role.charAt(0).toUpperCase()+r.role.slice(1)) %></span></td>
        <td><span class="badge <%= r.is_active ? 'badge-green' : 'badge-red' %>"><%= r.is_active ? 'Active' : 'Inactive' %></span></td>
      </tr>
      <% }) } else { %>
        <tr><td colspan="5" class="no-data">No logins yet — add a Principal login to get started.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
