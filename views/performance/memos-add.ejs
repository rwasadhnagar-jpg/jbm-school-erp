<%- include('../partials/header', { title: 'Issue Memo', activePage: 'performance' }) %>
<div class="page-header"><div><h1>➕ Issue Memo</h1><div class="breadcrumb"><a href="/performance/memos" style="color:rgba(255,255,255,0.8)">Memos</a> → Issue</div></div></div>

<div class="dashboard-widget" style="margin-bottom:16px">
  <div class="widget-body">A Discipline or Punctuality memo automatically adds one to that month's Discipline Issues / Late Arrivals count for this teacher. It also always appears on their report card as a standalone record.</div>
</div>

<form method="POST" action="/performance/memos/add">
<div class="form-card">
  <div class="form-card-header">⚠️ Memo Details</div>
  <div class="form-card-body">
    <div class="form-grid">
      <div class="form-group"><label>Teacher <span class="required">*</span></label>
        <select name="staff_id" class="form-control" required>
          <option value="">Select</option>
          <% staffList.forEach(function(s) { %><option value="<%= s.id %>"><%= s.first_name %> <%= s.last_name %></option><% }) %>
        </select>
      </div>
      <div class="form-group"><label>Date <span class="required">*</span></label><input type="date" name="memo_date" class="form-control" required></div>
      <div class="form-group"><label>Category <span class="required">*</span></label>
        <select name="category" id="category" class="form-control" required>
          <option value="Discipline">Discipline</option>
          <option value="Punctuality">Punctuality</option>
          <option value="Academic Non-Performance">Academic Non-Performance</option>
          <option value="Other">Other</option>
        </select>
      </div>
    </div>
    <div class="form-group" style="margin-top:12px">
      <label>Pre-drafted Text</label>
      <select id="draft-picker" class="form-control">
        <option value="">— Write your own —</option>
      </select>
    </div>
    <div class="form-group" style="margin-top:12px"><label>Description</label><textarea name="description" id="description" class="form-control" rows="4" placeholder="Pick a pre-drafted text above, or type your own here"></textarea></div>
  </div>
</div>
<div class="form-card"><div class="form-actions"><button type="submit" class="btn btn-purple">💾 Issue Memo</button><a href="/performance/memos" class="btn btn-outline-purple">Cancel</a></div></div>
</form>

<script>
const DRAFTS = {
  'Discipline': [
    'Failure to maintain classroom discipline as observed during a routine check.',
    'Complaint received from parents/students regarding inappropriate conduct.',
    'Failure to follow the school\'s disciplinary protocol in handling a student issue.',
    'Use of unauthorised disciplinary action against a student.'
  ],
  'Punctuality': [
    'Repeated late arrival to school beyond the permissible grace period.',
    'Frequent absence from assigned duty without prior intimation.',
    'Left school premises before scheduled hours without permission.',
    'Consistently late in reaching assigned class/period.'
  ],
  'Academic Non-Performance': [
    'Consistent decline in student performance in the assigned subject(s).',
    'Failure to complete the syllabus within the stipulated timeframe.',
    'Non-submission of student marks/assessments within the deadline.',
    'Inadequate lesson preparation observed during classroom review.'
  ],
  'Other': []
};

const categoryEl = document.getElementById('category');
const draftEl = document.getElementById('draft-picker');
const descEl = document.getElementById('description');

function populateDrafts() {
  const list = DRAFTS[categoryEl.value] || [];
  draftEl.innerHTML = '<option value="">— Write your own —</option>' +
    list.map(t => `<option value="${t.replace(/"/g,'&quot;')}">${t}</option>`).join('');
}

categoryEl.addEventListener('change', populateDrafts);
draftEl.addEventListener('change', () => {
  if (draftEl.value) descEl.value = draftEl.value;
});
populateDrafts();
</script>

<%- include('../partials/footer') %>
