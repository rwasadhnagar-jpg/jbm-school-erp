<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Parent Portal — JBM School</title>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:'Segoe UI',Arial,sans-serif;background:#f4f0fa;color:#222;min-height:100vh}
    .navbar{background:#4A0E8F;color:#fff;padding:0 24px;height:56px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 2px 8px rgba(74,14,143,.3)}
    .navbar-brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:16px}
    .navbar-brand img{width:34px;height:34px;object-fit:contain;background:#fff;border-radius:50%;padding:2px}
    .navbar-right{display:flex;align-items:center;gap:16px;font-size:13px}
    .navbar-right a{color:rgba(255,255,255,.85);text-decoration:none}
    .navbar-right a:hover{color:#fff}
    .container{max-width:960px;margin:0 auto;padding:24px 16px}
    .welcome-banner{background:linear-gradient(135deg,#4A0E8F,#7B2FBE);color:#fff;border-radius:12px;padding:18px 22px;margin-bottom:18px}
    .welcome-banner h2{font-size:19px;font-weight:800}
    .welcome-banner p{font-size:13px;opacity:.85;margin-top:3px}
    .child-card{background:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:18px;overflow:hidden;border-left:4px solid #4A0E8F}
    .child-header{background:#f8f5fd;padding:14px 18px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #eee}
    .child-header h3{font-size:16px;color:#4A0E8F}
    .child-header .class-badge{background:#4A0E8F;color:#fff;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600}
    .child-body{padding:14px 18px}
    .child-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:12px}
    .child-stat{text-align:center;padding:10px;background:#f8f5fd;border-radius:8px}
    .child-stat .label{font-size:11px;color:#888;text-transform:uppercase;font-weight:600}
    .child-stat .value{font-size:18px;font-weight:800;color:#4A0E8F;margin-top:2px}
    .child-actions{display:flex;gap:8px;flex-wrap:wrap}
    .child-actions a{padding:8px 16px;background:#4A0E8F;color:#fff;border-radius:6px;text-decoration:none;font-size:13px;font-weight:600}
    .child-actions a:hover{background:#5c1ab0}
    .child-actions a.outline{background:transparent;border:1px solid #4A0E8F;color:#4A0E8F}
    .card{background:#fff;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:18px;overflow:hidden}
    .card-header{background:#4A0E8F;color:#fff;padding:11px 16px;font-weight:700;font-size:14px}
    .card-body{padding:14px 16px}
    .notice-item{padding:10px 0;border-bottom:1px solid #f0f0f0;font-size:13px}
    .notice-item:last-child{border-bottom:none}
    .notice-item .notice-title{font-weight:600;color:#333}
    .notice-item .notice-date{font-size:11px;color:#999;margin-top:2px}
    .alert{padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:13px}
    .alert-error{background:#fdecea;color:#c62828;border:1px solid #f5c6cb}
    .alert-success{background:#e8f5e9;color:#2e7d32;border:1px solid #c8e6c9}
    @media(max-width:600px){.child-stats{grid-template-columns:1fr 1fr}.child-actions{flex-direction:column}}
  </style>
  <link rel="manifest" href="/manifest.json">
  <script src="/js/push.js" defer></script>
</head>
<body>
<nav class="navbar">
  <div class="navbar-brand">
    <img src="/img/logo.png" alt="JBM" onerror="this.style.display='none'">
    <span>JBM Public School — Parent Portal</span>
  </div>
  <div class="navbar-right">
    <button id="enable-push-btn" type="button" style="background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.3);color:#fff;border-radius:6px;padding:4px 10px;font-size:12px;cursor:pointer">🔔 Enable Notifications</button>
    <span>Welcome, <%= parentName %></span>
    <a href="/logout">Logout</a>
  </div>
</nav>

<div class="container">
  <% if (typeof error !== 'undefined' && error && error.length) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success && success.length) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <div class="welcome-banner">
    <h2>Welcome, <%= parentName %></h2>
    <p>You have <%= childData.length %> child<%= childData.length > 1 ? 'ren' : '' %> enrolled at JBM Public School</p>
  </div>

  <% childData.forEach(function(item) { %>
    <div class="child-card">
      <div class="child-header">
        <h3><%= item.student.first_name %> <%= item.student.last_name %></h3>
        <span class="class-badge"><%= item.student.class_name %> - <%= item.student.section %></span>
      </div>
      <div class="child-body">
        <div class="child-stats">
          <div class="child-stat">
            <div class="label">Admission No</div>
            <div class="value" style="font-size:14px"><%= item.student.admission_no %></div>
          </div>
          <div class="child-stat">
            <div class="label">Roll No</div>
            <div class="value"><%= item.student.roll_no || '-' %></div>
          </div>
        </div>
        <div class="child-actions">
          <a href="/portal/progress/<%= item.student.id %>">📊 View Progress</a>
        </div>
      </div>
    </div>
  <% }); %>

  <% if (recentNotices && recentNotices.length) { %>
  <div class="card">
    <div class="card-header">Recent Notices</div>
    <div class="card-body">
      <% recentNotices.forEach(function(n) { %>
        <div class="notice-item">
          <div class="notice-title"><%= n.title %></div>
          <div class="notice-date"><%= new Date(n.created_at).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></div>
        </div>
      <% }); %>
    </div>
  </div>
  <% } %>
</div>
</body>
</html>
