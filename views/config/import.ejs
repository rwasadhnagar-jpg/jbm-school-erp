<%- include('../partials/header', { title, activePage, user, academicYear, success, error }) %>

<div class="page-header">
  <div>
    <h1>📥 Import Data</h1>
    <div class="breadcrumb">Configuration → Import Data from Other App</div>
  </div>
</div>

<style>
  .import-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 20px; margin-bottom: 24px; }
  .import-card { background: #fff; border-radius: 10px; border: 1px solid var(--border); box-shadow: var(--shadow); overflow: hidden; }
  .import-card-header { padding: 14px 18px; font-weight: 700; font-size: 15px; display: flex; align-items: center; gap: 10px; }
  .import-card-body { padding: 18px; }
  .import-card-body p { font-size: 13px; color: #666; margin-bottom: 14px; line-height: 1.5; }
  .import-card.students .import-card-header { background: #f0e8ff; color: #4A0E8F; border-bottom: 2px solid #4A0E8F; }
  .import-card.fees .import-card-header { background: #d4edda; color: #155724; border-bottom: 2px solid #28a745; }
  .import-card.attendance .import-card-header { background: #d1ecf1; color: #0c5460; border-bottom: 2px solid #007bff; }
  .file-drop { border: 2px dashed var(--border); border-radius: 8px; padding: 20px; text-align: center; background: #fafafa; cursor: pointer; transition: all 0.2s; margin-bottom: 12px; }
  .file-drop:hover { border-color: var(--purple); background: #f0e8ff; }
  .file-drop input[type=file] { display: none; }
  .file-drop .drop-icon { font-size: 28px; margin-bottom: 6px; }
  .file-drop .drop-text { font-size: 13px; color: #666; }
  .file-drop .drop-sub { font-size: 11px; color: #999; margin-top: 3px; }
  .columns-hint { background: #f8f9fa; border-radius: 6px; padding: 12px 14px; margin-top: 12px; font-size: 12px; color: #555; }
  .columns-hint strong { display: block; margin-bottom: 5px; color: #333; }
  .columns-hint code { background: #e9ecef; padding: 1px 5px; border-radius: 3px; font-size: 11px; }
  .col-list { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }
  .col-req { background: #f0e8ff; color: #4A0E8F; padding: 2px 7px; border-radius: 4px; font-size: 11px; font-weight: 600; }
  .col-opt { background: #e9ecef; color: #555; padding: 2px 7px; border-radius: 4px; font-size: 11px; }
  .year-select { width: 100%; margin-bottom: 12px; }
  .tip-box { background: #fff3cd; border: 1px solid #ffc107; border-radius: 8px; padding: 14px 16px; font-size: 13px; color: #856404; margin-bottom: 20px; }
  .tip-box strong { display: block; margin-bottom: 6px; font-size: 14px; }
  .tip-box ul { margin-left: 18px; margin-top: 4px; }
  .tip-box ul li { margin-bottom: 3px; }
  .download-template { font-size: 12px; color: var(--purple); font-weight: 600; text-decoration: underline; cursor: pointer; margin-top: 8px; display: inline-block; }
</style>

<div class="tip-box">
  <strong>💡 How to Import Data from Scientific Study or Any Other ERP</strong>
  <ul>
    <li>Export data from your old app as <strong>Excel (.xlsx) or CSV</strong></li>
    <li>Match the column names shown below (or rename columns to match)</li>
    <li>Import supports last <strong>5 academic years</strong> (2021-2022 to 2026-2027)</li>
    <li>Student import uses <strong>Admission No</strong> as unique key — existing students are updated, new ones added</li>
    <li>Fee import skips duplicate receipt numbers automatically</li>
    <li>Date format: <code>DD/MM/YYYY</code> or <code>YYYY-MM-DD</code> — both accepted</li>
  </ul>
</div>

<div class="import-grid">

  <!-- STUDENTS -->
  <div class="import-card students">
    <div class="import-card-header">👨‍🎓 Import Students</div>
    <div class="import-card-body">
      <p>Import student records from your previous ERP. Existing students (matched by Admission No) will be updated. New students will be added.</p>
      <form method="POST" action="/configuration/import/students" enctype="multipart/form-data">
        <label class="file-drop" id="dropStudents">
          <input type="file" name="file" accept=".xlsx,.xls,.csv" onchange="updateDrop('dropStudents',this)">
          <div class="drop-icon">📊</div>
          <div class="drop-text" id="dropStudentsLabel">Click to select Excel / CSV file</div>
          <div class="drop-sub">Supports .xlsx, .xls, .csv — max 20 MB</div>
        </label>
        <button type="submit" class="btn btn-purple" style="width:100%">⬆️ Import Students</button>
      </form>
      <div class="columns-hint">
        <strong>Required columns (exact names):</strong>
        <div class="col-list">
          <span class="col-req">Admission No</span>
          <span class="col-req">First Name</span>
        </div>
        <strong style="margin-top:8px">Optional columns:</strong>
        <div class="col-list">
          <span class="col-opt">Last Name</span>
          <span class="col-opt">Gender</span>
          <span class="col-opt">DOB</span>
          <span class="col-opt">Phone</span>
          <span class="col-opt">Class</span>
          <span class="col-opt">Father Name</span>
          <span class="col-opt">Mother Name</span>
          <span class="col-opt">Address</span>
          <span class="col-opt">Status</span>
        </div>
        <div style="margin-top:8px;font-size:11px;color:#888">Class must match class names in your ERP (e.g. "Class 5", "5-A", "Class 5 A")</div>
      </div>
    </div>
  </div>

  <!-- FEE PAYMENTS -->
  <div class="import-card fees">
    <div class="import-card-header">💰 Import Fee Payments</div>
    <div class="import-card-body">
      <p>Import historical fee payment records from past academic years. Duplicate receipt numbers are skipped automatically.</p>
      <form method="POST" action="/configuration/import/fees" enctype="multipart/form-data">
        <label class="file-drop" id="dropFees">
          <input type="file" name="file" accept=".xlsx,.xls,.csv" onchange="updateDrop('dropFees',this)">
          <div class="drop-icon">💳</div>
          <div class="drop-text" id="dropFeesLabel">Click to select Excel / CSV file</div>
          <div class="drop-sub">Supports .xlsx, .xls, .csv — max 20 MB</div>
        </label>
        <button type="submit" class="btn btn-green" style="width:100%">⬆️ Import Fee Payments</button>
      </form>
      <div class="columns-hint">
        <strong>Required columns:</strong>
        <div class="col-list">
          <span class="col-req">Admission No</span>
          <span class="col-req">Amount</span>
        </div>
        <strong style="margin-top:8px">Optional columns:</strong>
        <div class="col-list">
          <span class="col-opt">Receipt No</span>
          <span class="col-opt">Date</span>
          <span class="col-opt">Mode</span>
          <span class="col-opt">Remarks</span>
        </div>
        <div style="margin-top:8px;font-size:11px;color:#888">Mode: Cash, Cheque, UPI, Online, etc.</div>
      </div>
    </div>
  </div>

  <!-- ATTENDANCE -->
  <div class="import-card attendance">
    <div class="import-card-header">✅ Import Attendance</div>
    <div class="import-card-body">
      <p>Import historical attendance records. One row per student per day. Existing records for same student+date are updated.</p>
      <form method="POST" action="/configuration/import/attendance" enctype="multipart/form-data">
        <select name="academic_year" class="form-control year-select">
          <% academicYears.forEach(y => { %>
            <option value="<%= y %>"><%= y %></option>
          <% }) %>
        </select>
        <label class="file-drop" id="dropAtt">
          <input type="file" name="file" accept=".xlsx,.xls,.csv" onchange="updateDrop('dropAtt',this)">
          <div class="drop-icon">📋</div>
          <div class="drop-text" id="dropAttLabel">Click to select Excel / CSV file</div>
          <div class="drop-sub">Supports .xlsx, .xls, .csv — max 20 MB</div>
        </label>
        <button type="submit" class="btn btn-outline-purple" style="width:100%;border-color:#007bff;color:#007bff" onmouseover="this.style.background='#007bff';this.style.color='#fff'" onmouseout="this.style.background='';this.style.color='#007bff'">⬆️ Import Attendance</button>
      </form>
      <div class="columns-hint">
        <strong>Required columns:</strong>
        <div class="col-list">
          <span class="col-req">Admission No</span>
          <span class="col-req">Date</span>
        </div>
        <strong style="margin-top:8px">Optional columns:</strong>
        <div class="col-list">
          <span class="col-opt">Status</span>
          <span class="col-opt">Remarks</span>
        </div>
        <div style="margin-top:8px;font-size:11px;color:#888">Status: Present, Absent, Late, Leave (default: Present)</div>
      </div>
    </div>
  </div>

</div>

<!-- Academic Years Reference -->
<div class="form-card">
  <div class="form-card-header">📅 Supported Academic Years (Last 5 + Current)</div>
  <div class="form-card-body">
    <div style="display:flex;flex-wrap:wrap;gap:10px">
      <% academicYears.forEach((y,i) => { %>
      <div style="background:<%= i===academicYears.length-1?'#4A0E8F':'#f0e8ff' %>;color:<%= i===academicYears.length-1?'#fff':'#4A0E8F' %>;padding:8px 18px;border-radius:20px;font-size:13px;font-weight:700">
        <%= y %><%= i===academicYears.length-1?' (Current)':'' %>
      </div>
      <% }) %>
    </div>
    <p style="margin-top:12px;font-size:12px;color:#888">All imported data is stored in the system. Use the <strong>Fee Collection Report</strong> and filters to view data by academic year.</p>
  </div>
</div>

<script>
function updateDrop(dropId, input) {
  const label = document.getElementById(dropId + 'Label');
  if (input.files && input.files[0]) {
    label.textContent = '✅ ' + input.files[0].name;
    label.style.color = '#4A0E8F';
    label.style.fontWeight = '600';
  }
}
// Drag & drop support
document.querySelectorAll('.file-drop').forEach(drop => {
  drop.addEventListener('dragover', e => { e.preventDefault(); drop.style.borderColor='#4A0E8F'; drop.style.background='#f0e8ff'; });
  drop.addEventListener('dragleave', () => { drop.style.borderColor=''; drop.style.background=''; });
  drop.addEventListener('drop', e => {
    e.preventDefault();
    drop.style.borderColor=''; drop.style.background='';
    const input = drop.querySelector('input[type=file]');
    input.files = e.dataTransfer.files;
    updateDrop(drop.id, input);
  });
});
</script>

<%- include('../partials/footer') %>
