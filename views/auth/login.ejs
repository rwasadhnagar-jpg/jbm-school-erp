<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — JBM School ERP</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .login-tabs { display:flex; gap:0; margin-bottom:24px; border-radius:8px; overflow:hidden; border:1px solid #e0e0e0; }
    .login-tab { flex:1; padding:12px; text-align:center; cursor:pointer; background:#f5f5f5; color:#666; font-weight:600; font-size:14px; text-decoration:none; transition:all 0.2s; }
    .login-tab.active { background:#1a73e8; color:#fff; }
    .login-tab:hover:not(.active) { background:#e8e8e8; }
  </style>
</head>
<body>
<div class="login-page">
  <div class="login-box">
    <div class="login-logo">
      <div class="logo-circle">🏫</div>
      <div class="school-name">JBM Public School</div>
      <div class="erp-label">School Management System</div>
    </div>

    <div class="login-tabs">
      <a href="/login" class="login-tab <%= tab === 'staff' ? 'active' : '' %>">Staff / Admin</a>
      <a href="/parent-login" class="login-tab <%= tab === 'parent' ? 'active' : '' %>">Parent Portal</a>
    </div>

    <% if (typeof error !== 'undefined' && error && error.length) { %>
      <div class="alert alert-error">⚠️ <%= error[0] || error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success && success.length) { %>
      <div class="alert alert-success">✅ <%= success[0] || success %></div>
    <% } %>

    <% if (tab === 'staff') { %>
      <form method="POST" action="/login">
        <div class="form-group">
          <label>Email Address</label>
          <input type="email" name="email" class="form-control" placeholder="Enter your email" required autofocus>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" class="form-control" placeholder="Enter password" required>
        </div>
        <button type="submit" class="login-btn">Sign In</button>
      </form>
    <% } else if (tab === 'parent') { %>
      <form method="POST" action="/parent-login">
        <div class="form-group">
          <label>Student Admission Number</label>
          <input type="text" name="admission_no" class="form-control" placeholder="e.g. JBM/2026/001" required autofocus>
        </div>
        <div class="form-group">
          <label>Registered Mobile Number</label>
          <input type="tel" name="mobile" class="form-control" placeholder="Enter your registered mobile" required>
        </div>
        <button type="submit" class="login-btn">Sign In as Parent</button>
      </form>
    <% } else { %>
      <form method="POST" action="/portal/login">
        <div class="form-group">
          <label>Admission Number</label>
          <input type="text" name="admission_no" class="form-control" placeholder="e.g. JBM/2026/001" required autofocus>
        </div>
        <div class="form-group">
          <label>Date of Birth</label>
          <input type="date" name="dob" class="form-control" required>
        </div>
        <button type="submit" class="login-btn">Sign In as Student</button>
      </form>
    <% } %>

    <div class="login-footer">
      Academic Year: <strong><%= typeof academicYear !== 'undefined' ? academicYear : '2026-2027' %></strong><br>
      &copy; 2026 JBM Public School — ERP v2.0
    </div>
  </div>
</div>
</body>
</html>
